DATABASE_URL="postgresql://clube:clube@localhost:5436/clube?schema=public"
PORT=3333
JWT_SECRET="troque-isto-em-producao"
CORS_ORIGIN=
UPLOAD_DIR=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@localhost"
NOTIFICATION_WINDOW_MINUTES=10
# NOTIFICATIONS_CRON=on liga o agendador do lembrete DENTRO do processo do
# Fastify (de 5 em 5 minutos). Vazio, ausente ou qualquer outro valor: desligado
# -- e ai o lembrete so sai quando um cron EXTERNO rodar notifications:dispatch.
# Nao e segredo, e chave de comportamento. Com duas instancias do backend,
# deixe desligado e use o cron externo.
NOTIFICATIONS_CRON=
SEED_ADMIN_EMAIL="admin@clube.local"
SEED_ADMIN_PASSWORD="troque-isto"
# SEED_ADMIN_FORCE_PASSWORD=1  # forca o seed a redefinir a senha do super-admin
#                                (por padrao o seed NUNCA sobrescreve senha existente)
