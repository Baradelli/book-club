// Schema dos Blocos A (Tarefa 03), B (Tarefa 07), C (Tarefa 11), E
// (Tarefa 24), F (Tarefa 32), G (Tarefa 34) e I (Tarefa 36). Os modelos vêm do
// esqueleto de referência em docs/plano-clube-do-livro.md §6, recortando as
// relações que apontam para modelos que ainda não existem (NoteLink,
// Attachment, NotificationDelivery) — cada um nasce na sua tarefa, com a sua
// migration.
//
// Onde este arquivo divergir do §6, a divergência está registrada num ADR:
// `ReadingPlanItem.order` tem @@index e não @@unique (ADR 0007), e
// `Note.updatedAt`/`Highlight.updatedAt` nascem sem @updatedAt (ADR 0008).
//
// Os ids têm @default(cuid()) apenas como rede de segurança: quem gera o id é
// o UseCase, com randomUUID().

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GeneralStatus {
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// Bloco C (Tarefa 11). Enum Prisma, e não `String` validado por `z.enum`: o
// par PLAN/FREE é fechado (`CLAUDE.md` lista só `ActivityEvent.type`,
// `NotificationDelivery.kind`, `PushSubscription.platform` e `Highlight.color`
// como os que ainda evoluem).
enum NoteKind {
  PLAN
  FREE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships       Membership[]
  settings          Settings?
  // Bloco I (Tarefa 36). Uma pessoa, N aparelhos — e NENHUM clube no meio: push
  // é da pessoa (decisão F).
  pushSubscriptions PushSubscription[]
  // Bloco I (Tarefa 37). A RESERVA do aviso do dia — uma linha por pessoa, por
  // tipo, por dia dela. Também sem clube no meio, pelo mesmo motivo.
  notificationDeliveries NotificationDelivery[]
  invitesMade       Invite[]           @relation("InviteCreator")
  invitesUsed       Invite[]           @relation("InviteUser")
  booksCreated      Book[]             @relation("BookCreator")
  notes             Note[]
  highlights        Highlight[]
  readingLogs       ReadingLog[]
  activity          ActivityEvent[]
}

model Club {
  id         String        @id @default(cuid())
  name       String
  timezone   String        @default("America/Sao_Paulo")
  status     GeneralStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())

  memberships Membership[]
  invites     Invite[]
  books       Book[]
  notes       Note[]
  highlights  Highlight[]
  readingLogs ReadingLog[]
  activity    ActivityEvent[]
}

model Membership {
  id       String        @id @default(cuid())
  userId   String
  clubId   String
  role     MemberRole    @default(MEMBER)
  status   GeneralStatus @default(ACTIVE)
  joinedAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id])
  club Club @relation(fields: [clubId], references: [id])

  @@unique([userId, clubId])
  @@index([clubId, status])
}

model Invite {
  id          String     @id @default(cuid())
  clubId      String
  code        String     @unique
  role        MemberRole @default(MEMBER)
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  createdAt   DateTime   @default(now())

  club      Club  @relation(fields: [clubId], references: [id])
  createdBy User  @relation("InviteCreator", fields: [createdById], references: [id])
  usedBy    User? @relation("InviteUser", fields: [usedById], references: [id])
}

// Bloco B (Tarefa 07). `notes` entrou na Tarefa 11 e `highlights` na 24 — o §6
// do plano está inteiro aqui agora.
model Book {
  id          String        @id @default(cuid())
  clubId      String
  title       String
  author      String?
  month       String // "YYYY-MM" — o mês do clube
  coverUrl    String?
  totalPages  Int?
  createdById String
  status      GeneralStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())

  club        Club              @relation(fields: [clubId], references: [id])
  createdBy   User              @relation("BookCreator", fields: [createdById], references: [id])
  planItems   ReadingPlanItem[]
  notes       Note[]
  highlights  Highlight[]
  readingLogs ReadingLog[]
  activity    ActivityEvent[]

  @@index([clubId, status])
}

model ReadingPlanItem {
  id        String   @id @default(cuid())
  bookId    String
  order     Int
  // `@db.Date` — dia de CALENDÁRIO, não instante. O domínio guarda a
  // CalendarDay como "YYYY-MM-DD" (string) e a conversão vive só no
  // repositório (calendar-day-mapper.ts), sempre em UTC.
  date      DateTime @db.Date
  title     String // o tema pré-definido: "Cap. 3 — A promessa"
  reference String? // texto livre: "p. 45-62"
  createdAt DateTime @default(now())

  book        Book            @relation(fields: [bookId], references: [id])
  notes       Note[]
  readingLogs ReadingLog[]
  activity    ActivityEvent[]

  // A chave natural do dia de leitura e do diff do replacePlanItems.
  @@unique([bookId, date])
  // ADR 0007: era @@unique. Índice único no Postgres não é deferível, e a
  // renumeração legítima de um plano (inserir um dia na frente) colidiria.
  // A unicidade de `order` é invariante de domínio: normalizePlanDrafts a
  // deriva da posição no array.
  @@index([bookId, order])
  @@index([bookId, date])
}

// Bloco C (Tarefa 11). `NoteLink` e `Attachment` do §6 do plano ficam
// recortados: nascem nas suas tarefas.
model Note {
  id         String        @id @default(cuid())
  clubId     String
  bookId     String
  userId     String // o AUTOR. Sempre o ator; nunca vem do input.
  kind       NoteKind
  // NULLABLE, e é isso que faz a anotação avulsa ser ilimitada: índice único
  // no Postgres não compara NULL com NULL, então N linhas com
  // (planItemId = NULL, userId = X) convivem. → Tarefa 08.
  planItemId String?
  title      String
  reference  String?
  // ProseMirror JSON, gravado como veio do editor. HTML nunca é persistido.
  // → ADR 0001.
  doc        Json
  // DERIVADO do `doc` pelo `docToText`, no backend. Nunca entra no input da
  // API. O `@default("")` é rede de segurança, como os `@default(cuid())`:
  // quem escreve o valor é o UseCase. → ADR 0001.
  plainText  String        @default("")
  status     GeneralStatus @default(ACTIVE)
  archivedAt DateTime?
  createdAt  DateTime      @default(now())
  // SEM `@updatedAt` de propósito: o dono deste instante é o domínio, como o
  // de `createdAt`, `archivedAt`, `joinedAt` e `usedAt`. `@updatedAt` não é
  // fallback, é OVERRIDE — bombearia a coluna em todo UPDATE, ignorando o que
  // o UseCase mandou, e o fake teria de emular o bombeamento. → ADR 0008.
  updatedAt  DateTime

  club     Club             @relation(fields: [clubId], references: [id])
  book     Book             @relation(fields: [bookId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  // `onDelete: Restrict` EXPLÍCITO, e não herdado: para relação OPCIONAL o
  // default do Prisma é `SetNull`, não `Restrict`. Sem esta declaração,
  // remover um dia do plano não falharia — zeraria o `planItemId` da nota e
  // deixaria uma linha com `kind = 'PLAN'` e `planItemId = null`, um estado
  // que nenhum UseCase produz, que o `listNotes({planItemId})` nunca mais
  // devolve e que ninguém percebe. Corrupção silenciosa.
  //
  // A guarda de domínio do `replacePlanItems` fica na frente disto (é ela que
  // dá a mensagem decente); este `Restrict` é a rede embaixo dela.
  planItem ReadingPlanItem? @relation(fields: [planItemId], references: [id], onDelete: Restrict)

  // A anotação do dia é UMA por pessoa por dia de leitura — e é o índice que
  // o upsert do `upsertPlanNote` usa como alvo, para dois autosaves
  // sobrepostos não virarem P2002.
  @@unique([planItemId, userId])
  // "as minhas anotações neste livro" — o filtro de navegação do ADR 0002.
  @@index([bookId, userId])
  // O acervo do clube, do mais recente para o mais antigo.
  @@index([clubId, createdAt])
}

// Bloco E (Tarefa 24) — o grifo que a pessoa fez no livro DE PAPEL. Entidade
// própria, com tabela, rotas e tela próprias, e **sem** vínculo com `Note` nem
// com `ReadingPlanItem`: registrar um grifo num dia em que não se escreveu nada
// é o caso real que decidiu isto. → ADR 0004. Um `noteId?` é aditivo se um dia
// surgir.
model Highlight {
  id     String @id @default(cuid())
  clubId String
  bookId String
  userId String // o AUTOR. Sempre o ator; nunca vem do input.
  quote  String // o trecho grifado, digitado à mão (ADR 0004: sem OCR)
  // `String` e não enum Prisma, e é decisão do `CLAUDE.md`: ele lista
  // `Highlight.color` entre os quatro campos "String validados por
  // z.enum/regex (ainda evoluem)" — o futuro registrado é paleta configurável
  // por clube, e um enum Prisma exigiria migration por cor. O portão é o
  // `z.enum(HIGHLIGHT_COLORS)` da borda mais o `assertHighlightColor` do
  // domínio, e o valor gravado é o hex minúsculo de 6 dígitos: UMA grafia por
  // cor, porque o `=` de texto do Postgres é byte-sensível.
  color  String
  // NULLABLE, e é caso legítimo: dá para grifar sem anotar a página. É a única
  // coluna filtrável nula, e no Postgres `WHERE "page" = 45` contra `NULL` é
  // FALSO — então o filtro por página não traz o grifo sem página. O fake
  // reproduz isso e tem teste (§7.1), e o contrato o prova contra o banco.
  //
  // `Int` (int32), e é o teto que o `.max(2147483647)` do schema Zod defende:
  // um valor fora dele faz o Prisma LANÇAR, e a rota responderia 500.
  page   Int?

  reference   String? // texto livre — capítulo, assunto, o que a pessoa quiser
  // ProseMirror JSON, como veio do editor. HTML nunca é persistido. → ADR 0001,
  // que nomeia `Highlight.commentDoc`/`commentText` na própria decisão.
  //
  // ⚠️ NULLABLE (decisão C da Tarefa 22): dá para registrar o grifo sem
  // comentário. E `Json?` no Prisma NÃO aceita `null` literal na escrita — o
  // tipo de entrada é `DbNull | JsonNull | InputJsonValue` —, então o
  // repositório usa `Prisma.DbNull` para "não há comentário", com teste de
  // contrato provando que volta como `null` do domínio (e não a string
  // `"null"`, nem um sentinela).
  commentDoc  Json?
  // DERIVADO do `commentDoc` pelo `docToText`, no backend. Nunca entra no input
  // da API. O `@default("")` é rede de segurança, como os `@default(cuid())`:
  // quem escreve o valor é o UseCase. → ADR 0001.
  commentText String        @default("")
  status      GeneralStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  // SEM `@updatedAt`, exatamente como o `Note`: o dono deste instante é o
  // domínio. `@updatedAt` não é fallback, é OVERRIDE — bombearia a coluna em
  // todo UPDATE, ignorando o que o UseCase mandou, e o fake teria de emular o
  // bombeamento. → ADR 0008, que EMENDA o `docs/plano-clube-do-livro.md` §6
  // (ele declara `updatedAt DateTime @updatedAt` no `Highlight` e está
  // desatualizado).
  updatedAt   DateTime

  // As três relações são OBRIGATÓRIAS, e o `onDelete` foi LIDO do SQL que o
  // Prisma gera (`prisma migrate diff --from-empty --to-schema-datamodel
  // prisma/schema.prisma --script`), não suposto: as três saem
  // `ON DELETE RESTRICT ON UPDATE CASCADE`. É o default do Prisma para relação
  // obrigatória — ao contrário do default para relação OPCIONAL, que é
  // `SetNull` (foi essa suposição errada que a Tarefa 06 fez e a 11 corrigiu no
  // `Note.planItem`). Restrict é o que queremos: apagar um livro, um clube ou
  // uma pessoa que tem grifo tem de FALHAR, não zerar coluna nenhuma — o acervo
  // do clube continua íntegro, com autoria (ADR 0002).
  club Club @relation(fields: [clubId], references: [id])
  book Book @relation(fields: [bookId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // NENHUM `@@unique`: o grifo é ILIMITADO. Grifar o mesmo trecho outra vez
  // numa releitura, com outra cor, é o caso de uso — um `@@unique` o
  // transformaria em 409.
  //
  // "os meus grifos neste livro" — o filtro de navegação do ADR 0002/0004.
  @@index([bookId, userId])
  // "os grifos amarelos deste livro" — o filtro por cor do ADR 0004.
  @@index([bookId, color])
  // O acervo do clube, do mais recente para o mais antigo: é a ordem em que o
  // `listHighlights` o pede, e o mesmo índice que o `Note` tem.
  @@index([clubId, createdAt])
}

// Bloco F (Tarefa 32) — "eu li o trecho de hoje". SEIS colunas e nada mais: o
// docblock de `src/domain/reading-log.ts` é o dono de cada ausência, e elas são
// decisão, não esquecimento.
//
// - SEM `status`/`archivedAt`: `ReadingLog` é log IMUTÁVEL, a exceção
//   documentada ao soft delete do projeto (`CLAUDE.md`). Desmarcar "li" é hard
//   delete da linha.
// - SEM `updatedAt`: nenhum caminho reescreve a linha. Instante sem dono é
//   campo que mente (ADR 0008).
// - SEM `createdAt`: ele É o `readAt` — a linha nasce no ato de marcar, e dois
//   nomes para o mesmo instante são a duplicação que a lição nº 3 do MVP 1
//   proíbe.
// - SEM contador e SEM percentual: progresso é CALCULADO a partir dos logs,
//   nunca guardado (decisão fechada do MVP 3).
model ReadingLog {
  id         String   @id @default(cuid())
  clubId     String
  bookId     String
  userId     String // o LEITOR. Sempre o ator; nunca vem do input.
  // NÃO anulável — a diferença que salta aos olhos em relação ao `Note`, onde
  // ele é nulo justamente para a anotação avulsa existir. Não existe leitura
  // avulsa: ler é sempre ler um trecho do plano.
  planItemId String
  // SEM `@default(now())`, ao contrário de todo `createdAt` do projeto: o dono
  // do instante é o UseCase (ADR 0008), e aqui nem a rede de segurança faz
  // sentido — uma linha inserida por fora sem `readAt` é uma leitura sem hora,
  // e é melhor o INSERT falhar do que gravar "agora" por acidente.
  readAt     DateTime

  club     Club            @relation(fields: [clubId], references: [id])
  book     Book            @relation(fields: [bookId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  // `onDelete: Restrict` EXPLÍCITO, e não herdado. Para relação OBRIGATÓRIA o
  // default do Prisma já é `Restrict` (lido do SQL gerado na Tarefa 24, não
  // suposto) — mas foi exatamente um implícito que quase produziu corrupção
  // silenciosa no `Note.planItem`, onde a relação é OPCIONAL e o default é
  // `SetNull`. A regra que sai daquele susto é declarar, e dizer por quê:
  // remover um dia do plano que alguém já leu tem de FALHAR, não apagar nem
  // zerar o registro de leitura de ninguém.
  //
  // ⚠️ E aqui NÃO há guarda de domínio na frente deste `Restrict`, ao
  // contrário do `Note`: o `replacePlanItems` confere nota
  // (`planItemIdsWithAnyNote`) e NÃO confere leitura. Medido na Tarefa 32 e
  // registrado no relatório dela: remover um dia que só tem leitura estoura
  // aqui, como erro de banco (500), em vez do 400 com mensagem. Nada é
  // gravado — a operação inteira é uma transação —, então é o STATUS que está
  // errado, não o dado.
  planItem ReadingPlanItem @relation(fields: [planItemId], references: [id], onDelete: Restrict)

  // A identidade do registro: o par (dia, pessoa). É ele que faz a
  // idempotência do `markRead` ser do BANCO e não só do UseCase — dois toques
  // simultâneos na tela, ou o retry da fila offline, viram UMA linha. E é por
  // ele existir que nenhum dos dois UseCases recebe id de log no input: o log
  // de outra pessoa é inalcançável (decisão E da Tarefa 30).
  @@unique([planItemId, userId])
  // "quem já leu cada dia deste livro" — a sobreposição da tela do livro e o
  // `computeBookProgress`. É a única consulta por coleção que existe.
  //
  // NADA de `@@index([clubId, createdAt])`, que as outras tabelas de conteúdo
  // têm: não há listagem cronológica de leitura em lugar nenhum do produto, e
  // índice sem consulta é custo de escrita à toa (decisão G da Tarefa 32).
  @@index([bookId])
}

// Bloco G (Tarefa 34) — "a Maria escreveu sobre o Cap. 3": o registro de que
// alguém do clube leu, escreveu ou grifou. OITO colunas e nada mais: o docblock
// de `src/domain/activity-event.ts` é o dono de cada ausência, e elas são
// decisão, não esquecimento.
//
// - SEM `status`/`archivedAt`: `ActivityEvent` é log IMUTÁVEL (`CLAUDE.md`).
//   E aqui nem a exceção do `ReadingLog` existe — desmarcar "li" apaga o log,
//   mas o evento "a Maria leu" já aconteceu, e o feed conta o que aconteceu
//   (decisão B da Tarefa 33). Nada arquiva e nada apaga: o port não tem
//   `update` nem `delete`.
// - SEM `updatedAt`: nenhum caminho reescreve a linha. Instante sem dono é
//   campo que mente (ADR 0008).
// - SEM título do dia, nome do livro ou nome de quem fez: o evento guarda
//   REFERÊNCIA, nunca conteúdo (decisão G da Tarefa 33). O título do dia muda
//   (`editBook` ressincroniza até o título da nota), e um evento com título
//   velho é uma tela que mente. O feed resolve na leitura.
// - SEM contagem de nada: `COUNTER_SHAPE` proíbe, e progresso é presença.
model ActivityEvent {
  id         String   @id @default(cuid())
  clubId     String
  userId     String // o ATOR. Sempre o ator; nunca vem do input.
  // `String` e não enum Prisma, e é decisão do `CLAUDE.md`: ele lista
  // `ActivityEvent.type` ao lado de `NotificationDelivery.kind`,
  // `PushSubscription.platform` e `Highlight.color` como os campos "String
  // validados por z.enum/regex (ainda evoluem)" — a lista de verbos do feed
  // ainda cresce, e um enum Prisma exigiria migration por verbo. O portão são
  // o `z.enum(ACTIVITY_TYPES)` da borda e o `assertActivityType` do domínio.
  type       String
  bookId     String
  // ANULÁVEL, e é o produto que decide: a anotação AVULSA e o GRIFO não têm dia
  // de leitura. É a diferença que salta aos olhos em relação ao `ReadingLog`,
  // onde a coluna é NOT NULL porque não existe leitura avulsa. `PLAN_NOTE` e
  // `READ` preenchem; `FREE_NOTE` e `HIGHLIGHT` gravam NULL.
  planItemId String?
  // O id da `Note` / do `Highlight` / do `ReadingLog` que acabou de nascer.
  // NÃO é uma FK: as três tabelas são alvos diferentes conforme o `type`, e uma
  // FK por tipo seria três colunas anuláveis com uma só preenchida. E o log é
  // imutável — arquivar a nota não desfaz o evento de tê-la escrito.
  subjectId  String
  // O instante em que aconteceu, e é o ÚNICO da linha. O `@default(now())` é
  // rede de segurança, como os `@default(cuid())`: quem escreve o valor é o
  // `recordActivity`, com UMA leitura de relógio (ADR 0008).
  //
  // ⚠️ Ele SEGUE a convenção dos outros sete modelos (todo campo chamado
  // `createdAt` no projeto tem esta rede) e DIVERGE do irmão mais próximo — o
  // `ReadingLog.readAt`, que nasceu sem `@default` de propósito. A divergência
  // é deliberada, não descuido: lá o campo tem outro nome e outro significado
  // (uma linha inserida por fora sem `readAt` seria uma leitura sem hora, e é
  // melhor o INSERT falhar); aqui a rede segue o padrão de `createdAt`, e quem
  // garante que o valor é do domínio é o teste de contrato
  // `stores the createdAt the domain sent, down to the millisecond`, que
  // asserta a COLUNA e não o que o mapper devolveu.
  createdAt  DateTime @default(now())

  // As três primeiras relações são OBRIGATÓRIAS e a quarta é OPCIONAL, e as
  // QUATRO declaram `onDelete: Restrict` EXPLICITAMENTE. Para relação
  // obrigatória o default do Prisma já é `Restrict`; para relação OPCIONAL ele
  // é `SetNull` — e foi exatamente esse implícito que quase produziu corrupção
  // silenciosa no `Note.planItem`. A regra que saiu daquele susto é declarar, e
  // dizer por quê: apagar um clube, uma pessoa, um livro ou um dia do plano que
  // o feed referencia tem de FALHAR, não zerar coluna nenhuma — um evento com
  // `planItemId` zerado viraria um "escreveu sobre o dia nenhum", que nenhum
  // UseCase produz e que a tela do feed não sabe desenhar.
  //
  // ⚠️ E a CONSEQUÊNCIA medida (decisão H da Tarefa 34): o `planItem` faz desta
  // a TERCEIRA FK que pode recusar a remoção de um dia no `replacePlanItems`,
  // ao lado de `Note_planItemId_fkey` e `ReadingLog_planItemId_fkey`.
  //
  // ⚠️ **As TRÊS têm guarda de domínio na frente desde a Tarefa 34b** (400 com
  // mensagem, em vez do `P2003` cru que a borda relançava como 500): esta é o
  // `planItemIdsWithAnyActivityEvent`. A lacuna que a Tarefa 34 registrou aqui
  // ACABOU — o caminho era um dia lido e depois DESMARCADO, que perde o
  // `ReadingLog` (hard delete) e mantém o evento.
  //
  // Os dois testes que pinam esta FK, pelo NOME (nunca pela linha — §7.4):
  // - a rede, no contrato: `is the net under the domain guard: it refuses a day
  //   that only an activity event anchors`;
  // - a recusa educada, no unitário do UseCase: o `describe('the guard that
  //   refuses to remove a day that has activity')`.
  //
  // ⚠️ E quem garante que a QUARTA FK não nasça sem guarda não é este
  // comentário: é `src/usecases/__tests__/plan-item-fk-guards.test.ts`, que LÊ
  // este arquivo, acha toda relação com `ReadingPlanItem` que recuse a remoção
  // — o `onDelete: Restrict` declarado E o implícito de relação obrigatória — e
  // fica vermelho nomeando a que estiver sem guarda. Duas fatias seguidas
  // (32→32c, 34→34b) introduziram FK sem guarda; requisito sem guarda
  // automática é intenção (`docs/CONVENCOES-CODIGO.md` §7.9).
  club     Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Restrict)
  planItem ReadingPlanItem? @relation(fields: [planItemId], references: [id], onDelete: Restrict)

  // O feed do clube, do mais recente para o mais antigo — é EXATAMENTE a
  // consulta do `find`, e o mesmo índice que `Note` e `Highlight` já têm.
  //
  // NADA de índice por `type` nem por `userId` (decisão G): não há filtro por
  // eles no escopo, e índice sem consulta é custo de escrita à toa — a mesma
  // conta que deixou o `ReadingLog` com um índice só.
  @@index([clubId, createdAt])
}

// NENHUM `@@unique`: o evento é ILIMITADO. Escrever a anotação do dia 1 e a do
// dia 2 são dois acontecimentos, e grifar o mesmo livro numa releitura também.
// Quem impede a enxurrada do autosave não é o banco — é a decisão A da Tarefa
// 33, no UseCase, que só dispara no nascimento (`created === true`).

// Bloco I (Tarefa 36) — "este aparelho recebe push". NOVE colunas e nada mais:
// o docblock de `src/domain/push-subscription.ts` é o dono de cada ausência, e
// elas são decisão, não esquecimento.
//
// - SEM `clubId` (decisão F): push é da PESSOA, não do clube. A mesma pessoa em
//   dois clubes tem UM aparelho, e pôr `clubId` obrigaria a decidir "qual
//   clube" num dado que não tem clube. É a mesma família do `Settings`, e as
//   duas são a exceção consciente ao "todo modelo de conteúdo carrega clubId"
//   do `CLAUDE.md` — nenhuma das duas é conteúdo de clube.
// - SEM `status`/`archivedAt`: a desativação é o `disabledAt`, e ela não é soft
//   delete de conteúdo — é "este aparelho não recebe mais". O nome vem do
//   `docs/NOTIFICACOES.md` §4 e do ADR 0006, que já o nomeiam, e dois nomes
//   para o mesmo instante são a duplicação que a lição nº 3 proíbe.
// - SEM `updatedAt`: nada reescreve a linha além do `disabledAt`, e esse
//   instante já É o registro da mudança. Instante sem dono mente (ADR 0008).
// - SEM `lastSentAt` e SEM contador de envio: a Tarefa 38 devolve
//   `{ sent, disabled }` ao chamador para logar, e o `NotificationDelivery`
//   (Tarefa 37) é o registro do que saiu.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String // o DONO. Sempre o ator; nunca vem do input.
  // `String` e não enum Prisma, e é decisão do `CLAUDE.md`: ele lista
  // `PushSubscription.platform` entre os quatro campos "String validados por
  // z.enum/regex (ainda evoluem)", ao lado de `ActivityEvent.type`,
  // `NotificationDelivery.kind` e `Highlight.color`. O portão são o
  // `z.enum(NOTIFICATION_PLATFORMS)` da borda e o
  // `assertNotificationPlatform` do domínio — este último também na LEITURA do
  // repositório, como o `assertActivityType`.
  platform   String
  // ⚠️ A IDENTIDADE da inscrição, e é do PROTOCOLO, não nossa: é a URL do
  // serviço de push do fabricante (FCM, Mozilla, WNS), e é por ela que o
  // aparelho é endereçado. Daí o `@@unique` abaixo e o upsert por ela.
  endpoint   String
  // As credenciais que cifram o payload daquele aparelho, como o navegador as
  // entregou. NENHUMA das duas sai em resposta alguma — o
  // `pushSubscriptionResponseSchema` não as declara, e o serializer do Zod
  // corta o que não está declarado (§6.1).
  p256dh     String
  auth       String
  // O que o navegador disse ser, quando disse. NULLABLE porque o corpo o
  // declara `optional()`: é só para a tela da 36b poder listar "este aparelho".
  userAgent  String?
  // ⚠️ O ÚNICO CAMPO MUTÁVEL da linha (decisão I), e `null` = ATIVA.
  //
  // A desativação é SOFT: o `DELETE` grava `now()` e o `POST` reativa gravando
  // `null` (`docs/NOTIFICACOES.md` §4). Soft e não hard porque a inscrição que
  // volta é o caso comum — a pessoa desliga o push, muda de ideia e o navegador
  // devolve o MESMO endpoint —, e um hard delete perderia `createdAt` e
  // `userAgent` a cada vaivém. A Tarefa 38 escreve nesta coluna pelo outro
  // caminho: `WebPushError` 404/410 (a pessoa desinstalou) marca `disabledAt`.
  disabledAt DateTime?
  // O `@default(now())` é rede de segurança, como os `@default(cuid())`: quem
  // escreve o valor é o UseCase, com UMA leitura de relógio (ADR 0008).
  createdAt  DateTime  @default(now())

  // `onDelete: Restrict` EXPLÍCITO, e não herdado — a regra que saiu do susto do
  // `Note.planItem`, onde o default de relação OPCIONAL é `SetNull`. Para
  // relação OBRIGATÓRIA como esta o default do Prisma já é `Restrict` (lido do
  // SQL gerado na Tarefa 24, não suposto), mas declarar é o que faz a
  // convenção virar requisito: apagar uma pessoa que tem aparelho inscrito tem
  // de FALHAR, não zerar coluna nenhuma — um `userId` nulo aqui seria uma
  // inscrição sem dono, que nenhum UseCase produz e que o envio da Tarefa 38
  // não saberia para quem mandar.
  //
  // ⚠️ **E a relação NÃO aponta para `ReadingPlanItem`** — de propósito, e é o
  // que mantém a guarda estrutural da Tarefa 34b
  // (`usecases/__tests__/plan-item-fk-guards.test.ts`) **verde sem uma linha de
  // mudança**: ela cobra guarda de domínio no `replacePlanItems` para toda FK
  // que recuse a remoção de um DIA DO PLANO, e esta recusa a remoção de uma
  // PESSOA. Não há dia de leitura em push nenhum: o lembrete se resolve pelo
  // `Settings.timezone` + `reminderTime` (ADR 0006), nunca por um vínculo com
  // um item de plano.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // A chave natural, e é o que faz o `POST` ser upsert (decisão E): dois
  // registros do mesmo endpoint fariam o mesmo aparelho receber duas vezes.
  @@unique([endpoint])
  // "as inscrições ATIVAS desta pessoa" — é a consulta do `byUserId`, que é a
  // que o envio da Tarefa 38 faz a cada push. NADA de índice por `disabledAt`
  // nem por `platform`: o conjunto por pessoa é de um punhado de linhas, e
  // índice sem consulta é custo de escrita à toa (a mesma conta que deixou o
  // `ReadingLog` com um índice só).
  @@index([userId])
}

// Bloco I (Tarefa 37) — "esta pessoa já recebeu ESTE aviso HOJE". CINCO colunas
// e nada mais: o docblock de `src/domain/notification-delivery.ts` é o dono de
// cada ausência, e elas são decisão, não esquecimento.
//
// Ela não é o registro de uma mensagem: é uma RESERVA. O dispatcher a pede
// ANTES de mandar qualquer coisa (decisão E da Tarefa 37), e o `@@unique`
// abaixo é quem garante que só uma passada — de qualquer instância, de qualquer
// processo — a consegue. É a idempotência do `docs/NOTIFICACOES.md` §6: por
// claim no banco, não por lock e não por memória, porque memória é exatamente o
// que reinicia.
//
// - SEM `clubId`: push é da PESSOA (decisão F da Tarefa 36), como o
//   `PushSubscription` e o `Settings`. A mesma pessoa em dois clubes recebe UM
//   lembrete por dia, e é isso que a chave diz.
// - SEM `status`/`archivedAt`/`updatedAt`: log IMUTÁVEL (`CLAUDE.md`), como o
//   `ReadingLog` e o `ActivityEvent`. Nada reescreve a linha, e instante sem
//   dono mente (ADR 0008).
// - SEM `payload`, SEM `title`, SEM `bookId`: o registro diz que SAIU, não o
//   que dizia. O texto vem do catálogo de i18n e muda com ele — guardá-lo aqui
//   seria histórico que envelhece mentindo (o mesmo argumento da decisão G da
//   Tarefa 33, que deixou o `ActivityEvent` sem o título do dia).
model NotificationDelivery {
  id        String @id @default(cuid())
  userId    String
  // `String` e não enum Prisma, e é decisão do `CLAUDE.md`: ele lista
  // `NotificationDelivery.kind` entre os quatro campos "String validados por
  // z.enum/regex (ainda evoluem)", ao lado de `ActivityEvent.type`,
  // `PushSubscription.platform` e `Highlight.color`. O portão são o
  // `z.enum(NOTIFICATION_KINDS)` de `@clube/shared` e o `assertNotificationKind`
  // do domínio — este último também na LEITURA do repositório, como o
  // `assertActivityType`.
  kind      String
  // ⚠️ `String` e NÃO `@db.Date` — a divergência deliberada com
  // `ReadingPlanItem.date`, e é a decisão F da Tarefa 37.
  //
  // Lá a coluna é uma data de calendário do PLANO, a mesma para o clube todo, e
  // o `calendar-day-mapper.ts` a traduz em UTC. Aqui ela é o dia NO FUSO DA
  // PESSOA: com um instante (ou com uma `DATE` em UTC), duas pessoas em fusos
  // diferentes no mesmo momento teriam a MESMA chave — e uma das duas ficaria
  // sem lembrete —, ou a mesma pessoa teria DUAS e receberia duas vezes. A
  // string "YYYY-MM-DD" é exatamente o que `localDay(instant, timeZone)`
  // devolve, e é por isso que a comparação do dispatcher é igualdade de string,
  // sem aritmética de data em lugar nenhum (decisão A).
  localDate String
  // SEM `@default(now())`, como o `ReadingLog.readAt` e ao contrário de todo
  // `createdAt` do projeto: o dono do instante é o dispatcher, que lê o relógio
  // UMA vez (ADR 0008 e regra 2 da Tarefa 37). Uma rede de segurança aqui
  // esconderia uma segunda leitura de relógio dentro do repositório, que é
  // justamente o que a regra 2 proíbe.
  deliveredAt DateTime

  // `onDelete: Restrict` EXPLÍCITO, e não herdado — a regra que saiu do susto do
  // `Note.planItem`, onde o default de relação OPCIONAL é `SetNull`. Para
  // relação OBRIGATÓRIA como esta o default do Prisma já é `Restrict`, mas
  // declarar é o que faz a convenção virar requisito.
  //
  // ⚠️ **E a relação NÃO aponta para `ReadingPlanItem`** — de propósito
  // (decisão J da Tarefa 37), e é o que mantém a guarda estrutural da 34b
  // (`usecases/__tests__/plan-item-fk-guards.test.ts`) verde SEM uma linha de
  // mudança: ela cobra guarda de domínio no `replacePlanItems` para toda FK que
  // recuse a remoção de um DIA DO PLANO, e esta recusa a remoção de uma PESSOA.
  //
  // O motivo de não haver o vínculo é de PRODUTO, não de esquema: o claim é por
  // dia de CALENDÁRIO no fuso da pessoa. Amarrá-lo ao item do plano faria a
  // chave mudar quando o admin editasse o plano — e o lembrete daquele dia
  // sairia de novo para quem já o tinha recebido. O plano é editável; o dia 5 de
  // outubro não é.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // ⚠️ A CHAVE DE IDEMPOTÊNCIA, e é a razão de a tabela existir: "no máximo um
  // aviso deste tipo, para esta pessoa, neste dia dela". É contra este índice
  // que o `INSERT ... ON CONFLICT DO NOTHING` do `claim` bate — a única exceção
  // de SQL explícito da feature (`docs/NOTIFICACOES.md` §6), e ela vive dentro
  // do repositório.
  //
  // NADA de índice por `deliveredAt` nem por `kind`: não existe listagem de
  // entrega em lugar nenhum do produto, e índice sem consulta é custo de escrita
  // à toa (a mesma conta que deixou o `ReadingLog` com um índice só). O
  // `@@unique` já começa por `userId`, então a busca por pessoa também o usa.
  @@unique([userId, kind, localDate])
}

model Settings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  timezone            String  @default("America/Sao_Paulo")
  locale              String  @default("pt")
  // "HH:mm", 24 horas, zero à esquerda obrigatório — e a regra tem DOIS donos, que
  // são o mesmo objeto: o `REMINDER_TIME_PATTERN` de `packages/shared/src/settings.ts`
  // (a borda, usado pelo `updateSettingsSchema`) e o `assertReminderTime` de
  // `src/domain/settings.ts`, que IMPORTA essa mesma constante. Duas barreiras, uma
  // regra só — um segundo regex escrito à mão seria a divergência do dia em que um
  // dos dois aceitasse "7:00".
  //
  // ⚠️ Este comentário dizia "validado por regex no Zod" desde a Tarefa 03, e era
  // FALSO: não havia regex nenhum (`grep -rn 'reminderTime' packages/shared/src`
  // voltava vazio), e a spec da 36 repetia a premissa. A Tarefa 36 o tornou
  // verdadeiro ao criar o `REMINDER_TIME_PATTERN` — 33 tarefas depois. Ele passou a
  // nomear os donos porque ponteiro sem dono faz o próximo agente procurar, não
  // achar e inventar um segundo regex (a lição do `dayRange` no `CLAUDE.md`).
  reminderTime        String  @default("21:00")
  reminderEnabled     Boolean @default(true)
  notifyGroupActivity Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}
